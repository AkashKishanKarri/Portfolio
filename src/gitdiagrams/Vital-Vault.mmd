node_student(("GITAM student"))

node_student -->|"signs up"| node_register
node_student -->|"signs in"| node_login
node_register -->|"saves profile"| node_user
node_login -->|"opens"| node_home
node_home -->|"checks"| node_guard
node_guard -->|"reads"| node_user
node_home -->|"lend"| node_lender
node_home -->|"rent"| node_renter
node_lender -->|"lists items"| node_items
node_renter -->|"books items"| node_items
node_renter -->|"notifies lender"| node_notify
node_notify -.->|"shown to"| node_lender
node_logout -->|"clears"| node_user

